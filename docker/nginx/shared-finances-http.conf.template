server {
    listen ${SF_APP_PORT};
    listen [::]:${SF_APP_PORT};
    server_name _;
    http2 on;

    root /usr/share/nginx/html;
    index index.html;

    location = /api {
        return 301 /api/;
    }

    # ^~ so the static regex locations below never steal an API path
    # (file downloads end in .png, .pdf, ...).
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:${SF_APP_API_PORT}/;
        include /etc/nginx/snippets/shared-finances-proxy.conf;
    }

    include /etc/nginx/snippets/shared-finances-static.conf;
}
